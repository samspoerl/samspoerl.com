{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Group Next.js packages",
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "Next.js"
    },
    {
      "description": "Group React packages",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "description": "Group Prisma packages",
      "matchPackageNames": ["prisma", "@prisma/client"],
      "groupName": "Prisma"
    },
    {
      "description": "Delay major updates by 14 days",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "Delay minor updates by 7 days and automerge",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Delay patch updates by 3 days and automerge",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days",
    "prPriority": 10,
    "automerge": true
  },
  "osvVulnerabilityAlerts": true
}
